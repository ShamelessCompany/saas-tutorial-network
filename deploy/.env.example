# Google / YouTube API
# Colocar client_secret.json y token.json dentro de la carpeta credentials/
YOUTUBE_PRIVACY_STATUS=public # Opciones: public, unlisted, private

# Opcional: Generacion automatica de guiones con Gemini API
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Intervalo entre publicaciones en horas
AGENT_INTERVAL_HOURS=8.0
